# Web Service — Environment Variables (SABLON; gercek secret YAZMAYIN)

# --- Database: PostgreSQL ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# APP_ENV=development

# --- Web / Flask ---
SECRET_KEY=change_me_in_production
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=False

# --- AI Service baglantisi ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT=300

# --- Seed / Provisioning admin (log'a yazilmaz) ---
PLATFORM_ADMIN_USERNAME=superadmin
PLATFORM_ADMIN_PASSWORD=change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
DEFAULT_TENANT_SLUG=default

# --- Binance (opsiyonel) ---
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true
