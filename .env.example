# ===============================================
# KRIPTO TRADING DASHBOARD — ENVIRONMENT VARIABLES
# ===============================================
# Bu dosya ŞABLONDUR. Gerçek secret/parola/anahtar YAZMAYIN, .env'e koyun.
# .env .gitignore ile dışlanmıştır.

# --- Database: PostgreSQL (SQLAlchemy + Alembic, schema-per-tenant) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# APP_ENV=development  # SQL echo log için (production'da kapalı)

# --- Seed / Provisioning admin bilgileri (log'a yazılmaz) ---
PLATFORM_ADMIN_USERNAME=superadmin
PLATFORM_ADMIN_PASSWORD=change_me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
DEFAULT_TENANT_SLUG=default

# --- Binance API ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true

# --- News Analysis API ---
NEWSAPI_KEY=your_newsapi_key_here
NEWSAPI_ENABLED=true

# --- Whale Tracker API ---
WHALE_ALERT_API_KEY=your_whale_alert_api_key_here
WHALE_TRACKER_ENABLED=true

# --- Flask Application ---
FLASK_SECRET_KEY=change_me_super_secret
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Model Configuration ---
MODEL_CACHE_ENABLED=true
MODEL_CACHE_DIR=model_cache
MODEL_MAX_AGE_DAYS=7
LSTM_EPOCHS=30
LSTM_TRAINING_DAYS=100
DQN_EPISODES=200

# --- Trading Configuration ---
AUTO_TRADING_ENABLED=false
RISK_PERCENTAGE=2
MAX_LEVERAGE=10
MIN_TRADE_AMOUNT=10

# --- Monitoring / System ---
DEFAULT_MONITORING_INTERVAL=15
CONFIDENCE_THRESHOLD=75
LOG_LEVEL=INFO

# --- Performance / Instrumentation ---
# Analiz süre ölçüm loglarını aç (⏱️ breakdown). Default kapalı (spam yok).
ANALYSIS_TIMING_ENABLED=false
# Bellek-içi model cache TTL (sn) ve maksimum coin sayısı
MODEL_MEMCACHE_TTL_SECONDS=21600
MODEL_MEMCACHE_MAX=50
# OHLCV response cache TTL (sn)
OHLCV_CACHE_TTL_SECONDS=60
# Dashboard analiz sonucu bu süreden eskiyse arka planda tazelenir (sn)
ANALYSIS_STALE_AFTER_SECONDS=900

# --- Veri doğruluğu ---
# DEMO_MODE yalnız test/geliştirme için: API key yoksa SAHTE (mock) haber/whale verisi üretir.
# Production'da MUTLAKA false: key yoksa ilgili adım atlanır + uyarı verilir (sahte sinyal yok).
DEMO_MODE=false

# --- Automation Engine (otomasyon motoru — Faz 4) ---
AUTO_DISCOVERY_ENABLED=true
AUTO_DISCOVERY_INTERVAL_MINUTES=15
AUTO_MIN_24H_VOLUME_USDT=10000000
AUTO_MAX_SYMBOLS_PER_SCAN=50
AUTO_ALLOWED_QUOTES=USDT
AUTO_EXCLUDED_SYMBOLS=USDC/USDT,TUSD/USDT,FDUSD/USDT
AUTO_MAX_SPREAD_PERCENT=1.0
AUTO_DEMO_MODE=false
# Canlı otomatik işlem — GÜVENLİK: default KAPALI. Faz 7 risk manager olmadan trade açılmaz.
AUTO_TRADE_ENABLED=false
# Skorlama ağırlıkları (opportunity_score bileşenleri; Faz 5'te teknik/AI devreye girer)
AUTO_W_TECHNICAL=0.35
AUTO_W_VOLUME_LIQUIDITY=0.20
AUTO_W_AI_PREDICTION=0.25
AUTO_W_SENTIMENT=0.10
AUTO_W_WHALE=0.10
AUTO_WATCHLIST_MIN_OPPORTUNITY=60
AUTO_HOT_MIN_OPPORTUNITY=75
AUTO_MAX_RISK_SCORE=70
# Faz 5: research'te AI (LSTM/DQN) kullan (TF gerekir; yoksa güvenle atlanır)
AUTO_USE_AI=true

# --- Risk Manager / Trade Safety (Faz 7) ---
# GÜVENLİK: Canlı işlem için AUTO_TRADE_ENABLED=true VE BINANCE_TESTNET=false VE risk onayı ŞART.
RISK_MAX_POSITION_PERCENT=5
RISK_MAX_DAILY_LOSS_PERCENT=5
RISK_MAX_DAILY_TRADES=10
RISK_MAX_OPEN_POSITIONS=5
RISK_MIN_CONFIDENCE=0.6
RISK_MAX_RISK_SCORE=60
RISK_COOLDOWN_AFTER_LOSS_MIN=60
RISK_REQUIRE_STOP_LOSS=true
RISK_ALLOWED_SYMBOLS=
RISK_BLOCKED_SYMBOLS=
# Trade yürütme (zorunlu SL/TP yüzdeleri + borsa tipi)
RISK_STOP_LOSS_PERCENT=2
RISK_TAKE_PROFIT_PERCENT=4
AUTO_EXCHANGE_TYPE=futures

# --- Simulation / Paper Trading (SANAL — canlı Binance işlemi YOK) ---
SIMULATION_MODE=true
SIM_SPOT_MAKER_FEE_RATE=0.001
SIM_SPOT_TAKER_FEE_RATE=0.001
SIM_FUTURES_MAKER_FEE_RATE=0.0002
SIM_FUTURES_TAKER_FEE_RATE=0.0005
SIM_USE_BNB_DISCOUNT=false
SIM_SLIPPAGE_RATE=0.0005

# --- Cloudflare Tunnel (web servisini internete açar; SECRET → gerçek token'ı .env'e yaz) ---
# Token'ı Cloudflare Zero Trust panelinden alın. Public hostname → http://web:5000 eşlemesi de orada yapılır.
# GÜVENLİK: gerçek token'ı BURAYA (commit'lenen şablona) YAZMAYIN — yalnız .env içine.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
# `docker compose up` ile tünelin de otomatik başlaması için (opsiyonel; yoksa: docker compose --profile tunnel up)
COMPOSE_PROFILES=tunnel

# --- GPU (NVIDIA) ile eğitim — YALNIZ NVIDIA GPU'lu Linux sunucuda ---
# Eğitim (LSTM/DQN) GPU'da koşsun istiyorsan CUDA'lı imajı devreye al.
# Gereksinim: host'ta NVIDIA sürücüsü + nvidia-container-toolkit
#   (test: docker run --rm --gpus all nvidia/cuda:12.2.0-base-ubuntu22.04 nvidia-smi).
# Aşağıdaki satırı SADECE GPU'lu sunucuda aç → düz `docker compose up --build -d` GPU imajını kullanır.
# (Alternatif: bayrakla çalıştır: docker compose -f docker-compose.yml -f docker-compose.gpu.yml up --build -d)
# NOT: GPU'suz makinede (ör. Mac) bu satırı AÇMA; deploy.devices 'nvidia' hatası verir.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#
# Her platformda CPU'ya zorlamak istersen (GPU olsa bile):
# TRADING_FORCE_CPU=1

# --- Market Intelligence + Ollama (LLM haber/sosyal analizi) ---
# Katmanı aç (haber toplama + analiz). Kapalıyken mevcut sistem değişmez.
INTELLIGENCE_ENABLED=false
# Haber/sosyal skorlarını automation opportunity/risk skoruna bağla (score_full).
AUTO_MARKET_INTEL_ENABLED=false
# Ollama (LLM). Sunucuda Docker'da Ollama çalışıyor; host'ta 11434 yayınlanmalı
# (test: curl http://localhost:11434/api/tags). Konteyner host.docker.internal ile erişir.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=2
OLLAMA_REQUIRE_JSON=true
# Toplama ayarları (opsiyonel)
# INTEL_NEWS_LOOKBACK_HOURS=48
# INTEL_MAX_ITEMS_PER_SOURCE=30
# INTEL_MAX_LLM_ITEMS=8           # Ollama'ya giden deduped haber sayısı (latency/maliyet)
# Skorlama ağırlıkları (opsiyonel; score_full mevcut bileşenler üzerinden normalize eder)
# AUTO_W_NEWS_QUALITY=0.10
# AUTO_W_SOCIAL_MOMENTUM=0.10
# Sosyal medya (Faz 5): Reddit + Google Trends momentum/hype/bot (X/Twitter YOK — ücretli)
INTEL_SOCIAL_ENABLED=false
INTEL_GOOGLE_TRENDS_ENABLED=true
# INTEL_SOCIAL_MAX_POSTS=40
